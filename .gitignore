# ========= .gitignore for .NET / C# Monorepo =========

# Visual Studio / IDE
.vscode/
.idea/
*.suo
*.user
*.userosscache
*.sln.docstates

# Build outputs
**/bin/
**/obj/
**/Debug/
**/Release/
**/publish/
**/out/

**/appsettings.Development.json
**/appsettings.Local.json
**/appsettings.*.local.json

# Rider
.idea/

# NuGet
*.nupkg
*.snupkg
packages/
.nuget/

# VS temporary & autogenerated
*.pdb
*.cache
*.vs/
*.dbmdl
*.opendb

# Logs and temporary files
*.log
*.tmp
*.temp

# OS files
.DS_Store
Thumbs.db

# Environment configs (optional)
.env
.env.local

**/.env

# Test results
TestResults/
coverage/
coverage-report/

# Optional: Ignore package managers you don’t want to track
node_modules/
